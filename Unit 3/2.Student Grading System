# Lab Exercise 2:Student Grading System
name = input("Enter student name: ")

marks = []

for i in range(5):
    m = float(input("Enter marks: "))
    marks.append(m)

total = sum(marks)
average = total / 5

print("\nStudent Name:", name)
print("Total Marks:", total)
print("Average:", average)

if average >= 90:
    print("Grade: A")
elif average >= 75:
    print("Grade: B")
elif average >= 60:
    print("Grade: C")
elif average >= 40:
    print("Grade: D")
else:
    print("Grade: Fail")